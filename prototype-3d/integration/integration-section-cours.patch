+/* ---------- Animation 3D décorative (section Cours) ---------- */
+/* Sur téléphone, elle n'est ni affichée ni téléchargée : le chemin vers les cours et WhatsApp reste court. */
+.video-3d { display: none; }
+@media (min-width: 900px) {
+  /* Texte à gauche, centré en hauteur ; animation à droite */
+  .entete-section--3d { display: grid; grid-template-columns: 1fr 230px; grid-template-rows: 1fr auto auto auto 1fr; column-gap: 64px; }
+  .entete-section--3d > :not(.video-3d) { grid-column: 1; }
+  .entete-section--3d .surtitre { grid-row: 2; justify-self: start; }
+  .entete-section--3d h2 { grid-row: 3; }
+  .entete-section--3d .intro { grid-row: 4; }
+  .video-3d {
+    display: block; position: relative; grid-column: 2; grid-row: 1 / -1;
+    width: 230px; aspect-ratio: 9 / 16; border-radius: 22px; overflow: hidden; background: var(--marine);
+    box-shadow: 0 30px 60px -30px rgba(4, 20, 46, .55);
+  }
+  .video-3d video { width: 100%; height: 100%; object-fit: contain; display: block; }
+}
+.video-3d__pause[hidden] { display: none; }
+.video-3d__pause {
+  position: absolute; right: 12px; bottom: 12px; width: 40px; height: 40px; border-radius: 50%;
+  display: grid; place-items: center; border: 1px solid rgba(255, 255, 255, .35); cursor: pointer;
+  background: rgba(4, 20, 46, .6); color: #fff;
+}
+.video-3d__pause svg { width: 18px; height: 18px; }
+.video-3d__icone-lecture, .video-3d__pause[aria-pressed="true"] .video-3d__icone-pause { display: none; }
+.video-3d__pause[aria-pressed="true"] .video-3d__icone-lecture { display: block; }
+
